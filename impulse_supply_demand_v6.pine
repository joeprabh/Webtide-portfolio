//@version=6
indicator("Impulse Supply & Demand (4H + 1H) - Golden Checklist", overlay = true, max_boxes_count = 500, max_labels_count = 200)

//========================================
// INPUTS
//========================================
tf4H           = input.timeframe("240", "4H Timeframe")
tf1H           = input.timeframe("60",  "1H Timeframe")
extendBars     = input.int(500, "Extend Bars Right", minval = 1)

minZoneSize    = input.float(0.0, "Min Zone Size (price units)", minval = 0.0)

// Impulse detection
impulseAtrMult = input.float(1.0, "Impulse Size vs ATR", minval = 0.1)

// Base candle behaviour (precise box drawing rules)
// If wick is >= 2x the body, ignore the lower/upper 50% of the wick.
longWickRatio  = input.float(2.0, "Long Wick Ratio (2.0 = ignore 50% of long wick)", minval = 0.1)

// Golden checklist controls
swingLookback  = input.int(10, "Swing Lookback Bars", minval = 2)
sweepLookback  = input.int(10, "Liquidity Sweep Lookback", minval = 2)
maxBaseBars    = input.int(3, "Max Base Candles Before Impulse", minval = 1, maxval = 5)

// Life-cycle
touchMode      = input.string("wick", "Touch Mode", options = ["wick", "body"])
expireBars     = input.int(0, "Expire After Bars (0 = off)", minval = 0)
keepLatestOnly = input.bool(true, "Keep Only Latest Zone per TF/Side")

// Colours (desert-ish)
color4HSupply  = input.color(color.new(color.rgb(190, 120, 90), 65), "4H Supply")
color4HDemand  = input.color(color.new(color.rgb(120, 170, 150), 65), "4H Demand")
color1HSupply  = input.color(color.new(color.rgb(210, 160, 100), 65), "1H Supply")
color1HDemand  = input.color(color.new(color.rgb(135, 160, 200), 65), "1H Demand")

//========================================
// TYPES
//========================================
type Zone
    int    bornIndex
    float  top
    float  bottom
    bool   fresh
    string tf
    string side
    box    boxId
    label  labelId

//========================================
// STORAGE
//========================================
var array<Zone> zones = array.new<Zone>()

//========================================
// HELPER FUNCTIONS
//========================================
getZoneColor(string tfParam, string side) =>
    tfParam == "240" ? (side == "supply" ? color4HSupply : color4HDemand) : (side == "supply" ? color1HSupply : color1HDemand)

// Has current bar touched zone?
isTouched(Zone z) =>
    touchMode == "wick" ? (high >= z.bottom and low <= z.top) : (math.max(open, close) >= z.bottom and math.min(open, close) <= z.top)

// Build demand zone from base candle following precise box rules
f_demandFromBase(float o, float c, float h, float l) =>
    float bodyTop   = math.max(o, c)
    float bodyBot   = math.min(o, c)
    float bodySize  = bodyTop - bodyBot
    float wickDown  = bodyBot - l
    float zTop      = bodyTop
    float zBottom   = bodyBot - (wickDown >= bodySize * longWickRatio ? wickDown * 0.5 : wickDown)
    [zTop, zBottom]

// Build supply zone from base candle (mirror of demand rule)
f_supplyFromBase(float o, float c, float h, float l) =>
    float bodyTop   = math.max(o, c)
    float bodyBot   = math.min(o, c)
    float bodySize  = bodyTop - bodyBot
    float wickUp    = h - bodyTop
    float zBottom   = bodyBot
    float zTop      = bodyTop + (wickUp >= bodySize * longWickRatio ? wickUp * 0.5 : wickUp)
    [zTop, zBottom]

// Create new zone (box glued to base candle)
createZone(int bornIdx, float top, float bottom, string tfParam, string side) =>
    Zone z = Zone.new()
    z.bornIndex := bornIdx
    z.top       := top
    z.bottom    := bottom
    z.fresh     := true
    z.tf        := tfParam
    z.side      := side
    color zoneColor = getZoneColor(tfParam, side)
    z.boxId := box.new(bornIdx, top, bornIdx + extendBars, bottom, zoneColor, 1, line.style_solid, extend.right, xloc.bar_index, zoneColor)
    string labelText = (tfParam == "240" ? "H4 " : "H1 ") + (side == "supply" ? "S" : "D") + " FRESH"
    float labelY = side == "supply" ? top : bottom
    z.labelId := label.new(bornIdx, labelY, labelText, xloc.bar_index, yloc.price, zoneColor, side == "supply" ? label.style_label_down : label.style_label_up, color.white, size.tiny)
    z

deleteZone(Zone z) =>
    box.delete(z.boxId)
    label.delete(z.labelId)
    true

// Find latest zone index for given tf + side
findZoneIndex(string tfParam, string side) =>
    int idx = -1
    int sz = array.size(zones)
    if sz > 0
        for i = 0 to sz - 1
            Zone z = array.get(zones, i)
            if z.tf == tfParam and z.side == side
                idx := i
    idx

removeZone(int idx) =>
    int sz = array.size(zones)
    if idx >= 0 and idx < sz
        Zone z = array.get(zones, idx)
        deleteZone(z)
        array.remove(zones, idx)
    true

// Determine whether consolidation before impulse stayed tight (1-3 candles, low range)
isTightBase(series float highs, series float lows, int baseOffset) =>
    int startIdx = baseOffset + 1
    int endIdx   = baseOffset + maxBaseBars
    float hiBase = na
    float loBase = na
    int barsCount = 0
    for j = startIdx to endIdx
        if not na(highs[j]) and not na(lows[j])
            hiBase := na(hiBase) ? highs[j] : math.max(hiBase, highs[j])
            loBase := na(loBase) ? lows[j]  : math.min(loBase, lows[j])
            barsCount += 1
    float rangeImpulse = highs[baseOffset] - lows[baseOffset]
    float rangeBase    = hiBase - loBase
    barsCount > 0 and barsCount <= maxBaseBars and rangeBase < rangeImpulse

// Liquidity sweep check
liquiditySweep(bool isDemand, series float highs, series float lows, int baseOffset) =>
    int lookBack = math.max(2, sweepLookback)
    isDemand ? lows[baseOffset + 2] < ta.lowest(lows[baseOffset + 3], lookBack) : highs[baseOffset + 2] > ta.highest(highs[baseOffset + 3], lookBack)

// Break of structure
brokeStructure(bool isDemand, series float highs, series float lows, int baseOffset, float impHigh, float impLow) =>
    int pivotLen = math.max(2, swingLookback)
    isDemand ? impHigh > ta.highest(highs[baseOffset + 2], pivotLen) : impLow < ta.lowest(lows[baseOffset + 2], pivotLen)

//========================================
// HTF DATA
//========================================
[o4H, h4H, l4H, c4H, t4H] = request.security(syminfo.tickerid, tf4H, [open, high, low, close, time], lookahead = barmerge.lookahead_off)
[o1H, h1H, l1H, c1H, t1H] = request.security(syminfo.tickerid, tf1H, [open, high, low, close, time], lookahead = barmerge.lookahead_off)

atr4H = request.security(syminfo.tickerid, tf4H, ta.atr(14), lookahead = barmerge.lookahead_off)
atr1H = request.security(syminfo.tickerid, tf1H, ta.atr(14), lookahead = barmerge.lookahead_off)

// Detect first LTF bar of a new HTF candle
new4H = ta.change(t4H) != 0
new1H = ta.change(t1H) != 0

//========================================
// 4H IMPULSE-BASED ZONES
//========================================
if new4H and not na(o4H[2]) and not na(atr4H[1])
    float impO = o4H[1]
    float impH = h4H[1]
    float impL = l4H[1]
    float impC = c4H[1]
    float baseO = o4H[2]
    float baseH = h4H[2]
    float baseL = l4H[2]
    float baseC = c4H[2]
    float rng    = impH - impL
    float atrVal = atr4H[1]
    bool bigMove = rng >= atrVal * impulseAtrMult
    bool upImpulse   = bigMove and impC > impO and impC > baseH
    bool downImpulse = bigMove and impC < impO and impC < baseL
    int baseIdx4  = bar_index
    bool tightBase    = isTightBase(h4H, l4H, 1)
    bool sweptLiqUp   = liquiditySweep(true, h4H, l4H, 1)
    bool sweptLiqDown = liquiditySweep(false, h4H, l4H, 1)
    bool bosUp        = brokeStructure(true, h4H, l4H, 1, impH, impL)
    bool bosDown      = brokeStructure(false, h4H, l4H, 1, impH, impL)

    if upImpulse and tightBase and sweptLiqUp and bosUp
        [zTopD, zBotD] = f_demandFromBase(baseO, baseC, baseH, baseL)
        if not na(zTopD) and zTopD - zBotD >= minZoneSize
            if keepLatestOnly
                int oldIdx = findZoneIndex("240", "demand")
                if oldIdx >= 0
                    removeZone(oldIdx)
            array.push(zones, createZone(baseIdx4, zTopD, zBotD, "240", "demand"))

    if downImpulse and tightBase and sweptLiqDown and bosDown
        [zTopS, zBotS] = f_supplyFromBase(baseO, baseC, baseH, baseL)
        if not na(zTopS) and zTopS - zBotS >= minZoneSize
            if keepLatestOnly
                int oldIdx2 = findZoneIndex("240", "supply")
                if oldIdx2 >= 0
                    removeZone(oldIdx2)
            array.push(zones, createZone(baseIdx4, zTopS, zBotS, "240", "supply"))

//========================================
// 1H IMPULSE-BASED ZONES
//========================================
if new1H and not na(o1H[2]) and not na(atr1H[1])
    float impO1 = o1H[1]
    float impH1 = h1H[1]
    float impL1 = l1H[1]
    float impC1 = c1H[1]
    float baseO1 = o1H[2]
    float baseH1 = h1H[2]
    float baseL1 = l1H[2]
    float baseC1 = c1H[2]
    float rng1     = impH1 - impL1
    float atrVal1  = atr1H[1]
    bool bigMove1 = rng1 >= atrVal1 * impulseAtrMult
    bool upImpulse1   = bigMove1 and impC1 > impO1 and impC1 > baseH1
    bool downImpulse1 = bigMove1 and impC1 < impO1 and impC1 < baseL1
    int baseIdx1  = bar_index
    bool tightBase1    = isTightBase(h1H, l1H, 1)
    bool sweptLiqUp1   = liquiditySweep(true, h1H, l1H, 1)
    bool sweptLiqDown1 = liquiditySweep(false, h1H, l1H, 1)
    bool bosUp1        = brokeStructure(true, h1H, l1H, 1, impH1, impL1)
    bool bosDown1      = brokeStructure(false, h1H, l1H, 1, impH1, impL1)

    if upImpulse1 and tightBase1 and sweptLiqUp1 and bosUp1
        [zTopD1, zBotD1] = f_demandFromBase(baseO1, baseC1, baseH1, baseL1)
        if not na(zTopD1) and zTopD1 - zBotD1 >= minZoneSize
            if keepLatestOnly
                int oldIdx3 = findZoneIndex("60", "demand")
                if oldIdx3 >= 0
                    removeZone(oldIdx3)
            array.push(zones, createZone(baseIdx1, zTopD1, zBotD1, "60", "demand"))

    if downImpulse1 and tightBase1 and sweptLiqDown1 and bosDown1
        [zTopS1, zBotS1] = f_supplyFromBase(baseO1, baseC1, baseH1, baseL1)
        if not na(zTopS1) and zTopS1 - zBotS1 >= minZoneSize
            if keepLatestOnly
                int oldIdx4 = findZoneIndex("60", "supply")
                if oldIdx4 >= 0
                    removeZone(oldIdx4)
            array.push(zones, createZone(baseIdx1, zTopS1, zBotS1, "60", "supply"))

//========================================
// UPDATE EXISTING ZONES (touch / expire)
//========================================
int zoneCount = array.size(zones)
if zoneCount > 0
    int i = zoneCount - 1
    while i >= 0
        Zone z = array.get(zones, i)
        bool shouldRemove = false
        if expireBars > 0 and (bar_index - z.bornIndex) > expireBars
            shouldRemove := true
        if not shouldRemove and z.fresh and isTouched(z)
            shouldRemove := true
        if shouldRemove
            removeZone(i)
        i -= 1

//========================================
// ALERT
//========================================
alertcondition(array.size(zones) > 0, "Zone Alert", "Impulse Supply/Demand Zone Created")
