//@version=6
indicator("Institutional Order Blocks - Professional", overlay=true, max_boxes_count=50, max_labels_count=50)

// ==================================================================================
// PROFESSIONAL ORDER BLOCK INDICATOR
// ALL 4 INSTITUTIONAL RULES - EXACTLY AS SPECIFIED
// ==================================================================================

// INPUTS
impulseMultiplier = input.float(1.8, "Impulse Multiplier (Body > ATR × this)", 
     minval=1.5, maxval=3.0, step=0.1,
     tooltip="1.8 = Balanced | 2.0 = Very Strict | 1.5 = More Zones")
bosLookback = input.int(10, "Structure Lookback Period", minval=5, maxval=20)
requireFVG = input.bool(true, "Require Fair Value Gap", 
     tooltip="ON = All 4 rules | OFF = Skip FVG (Rule 3)")
showLabels = input.bool(true, "Show Labels")
maxZones = input.int(30, "Maximum Fresh Zones", minval=10, maxval=50)

demandColor = input.color(color.new(color.green, 0), "Demand Color")
supplyColor = input.color(color.new(color.red, 0), "Supply Color")
boxTransparency = input.int(85, "Box Transparency", minval=70, maxval=95)

// ==================================================================================
// ZONE STORAGE TYPE
// ==================================================================================
type OrderBlock
    box b
    label l
    int barIndex
    int createdTime
    float top
    float bottom
    bool isDemand

var array<OrderBlock> orderBlocks = array.new<OrderBlock>()

// ==================================================================================
// CORE CALCULATIONS
// ==================================================================================
atr = ta.atr(14)
minBodySize = atr * impulseMultiplier

// ==================================================================================
// RULE DETECTION - ALL 4 RULES
// ==================================================================================
if bar_index >= bosLookback + 2
    
    // ==================================================================================
    // RULE 1: BASE PATTERN DETECTION
    // ==================================================================================
    // Demand Setup: Red candle [1] followed by Green candle [0]
    isRedCandle_1 = close[1] < open[1]
    isGreenCandle_1 = close[1] > open[1]
    isGreenCandle_0 = close > open
    isRedCandle_0 = close < open
    
    demandBasePattern = isRedCandle_1 and isGreenCandle_0
    supplyBasePattern = isGreenCandle_1 and isRedCandle_0
    
    // ==================================================================================
    // RULE 2: EXPLOSIVE IMPULSE (Extended Range Candle)
    // ==================================================================================
    currentCandleBody = math.abs(close - open)
    isExplosiveImpulse = currentCandleBody > minBodySize
    
    // ==================================================================================
    // RULE 3: FAIR VALUE GAP (Imbalance)
    // ==================================================================================
    // Demand FVG: Gap between high[2] and low[0] (no overlap)
    demandFVG = high[2] < low
    
    // Supply FVG: Gap between low[2] and high[0] (no overlap)
    supplyFVG = low[2] > high
    
    // FVG Pass Logic
    fvgPass_Demand = not requireFVG or demandFVG
    fvgPass_Supply = not requireFVG or supplyFVG
    
    // ==================================================================================
    // RULE 4: BREAK OF STRUCTURE (BOS)
    // ==================================================================================
    highestHigh = ta.highest(high, bosLookback)
    lowestLow = ta.lowest(low, bosLookback)
    
    breakOfStructure_Bullish = close > highestHigh[1]
    breakOfStructure_Bearish = close < lowestLow[1]
    
    // ==================================================================================
    // VALID ORDER BLOCK CONDITIONS (ALL 4 RULES MUST PASS)
    // ==================================================================================
    validDemandBlock = demandBasePattern and isExplosiveImpulse and fvgPass_Demand and breakOfStructure_Bullish
    validSupplyBlock = supplyBasePattern and isExplosiveImpulse and fvgPass_Supply and breakOfStructure_Bearish
    
    // ==================================================================================
    // DRAW DEMAND ORDER BLOCK (Drawn on RED base candle [1])
    // ==================================================================================
    if validDemandBlock
        // Zone Coordinates:
        // TOP = Body High of red candle = OPEN[1] (since close < open)
        // BOTTOM = Wick Low of red candle = LOW[1]
        zoneTop = open[1]
        zoneBottom = low[1]
        
        // Time coordinates for precise placement
        leftTime = time[1]
        rightTime = time + (time - time[1]) * 50
        
        // Draw Box with xloc.bar_time
        b = box.new(leftTime, zoneTop, rightTime, zoneBottom,
             xloc=xloc.bar_time,
             bgcolor=color.new(demandColor, boxTransparency),
             border_color=demandColor,
             border_width=2,
             border_style=line.style_solid)
        
        // Draw Label
        l = na
        if showLabels
            labelText = timeframe.period + " DEMAND"
            l = label.new(leftTime + (rightTime - leftTime) / 2, zoneBottom,
                 labelText,
                 xloc=xloc.bar_time,
                 style=label.style_label_up,
                 color=color.new(demandColor, 20),
                 textcolor=color.white,
                 size=size.tiny)
        
        // Store Order Block
        array.push(orderBlocks, OrderBlock.new(b, l, bar_index[1], time[1], zoneTop, zoneBottom, true))
    
    // ==================================================================================
    // DRAW SUPPLY ORDER BLOCK (Drawn on GREEN base candle [1])
    // ==================================================================================
    if validSupplyBlock
        // Zone Coordinates:
        // TOP = Wick High of green candle = HIGH[1]
        // BOTTOM = Body Low of green candle = OPEN[1] (since close > open)
        zoneTop = high[1]
        zoneBottom = open[1]
        
        // Time coordinates for precise placement
        leftTime = time[1]
        rightTime = time + (time - time[1]) * 50
        
        // Draw Box with xloc.bar_time
        b = box.new(leftTime, zoneTop, rightTime, zoneBottom,
             xloc=xloc.bar_time,
             bgcolor=color.new(supplyColor, boxTransparency),
             border_color=supplyColor,
             border_width=2,
             border_style=line.style_solid)
        
        // Draw Label
        l = na
        if showLabels
            labelText = timeframe.period + " SUPPLY"
            l = label.new(leftTime + (rightTime - leftTime) / 2, zoneTop,
                 labelText,
                 xloc=xloc.bar_time,
                 style=label.style_label_down,
                 color=color.new(supplyColor, 20),
                 textcolor=color.white,
                 size=size.tiny)
        
        // Store Order Block
        array.push(orderBlocks, OrderBlock.new(b, l, bar_index[1], time[1], zoneTop, zoneBottom, false))

// ==================================================================================
// ZONE MITIGATION (Delete when price touches)
// ==================================================================================
if array.size(orderBlocks) > 0
    for i = array.size(orderBlocks) - 1 to 0
        ob = array.get(orderBlocks, i)
        
        // Only check zones created BEFORE current bar
        if bar_index > ob.barIndex
            // Check if current bar touched the zone
            zoneTouched = low <= ob.top and high >= ob.bottom
            
            if zoneTouched
                box.delete(ob.b)
                if not na(ob.l)
                    label.delete(ob.l)
                array.remove(orderBlocks, i)

// ==================================================================================
// LIMIT MAXIMUM ZONES (Keep chart clean)
// ==================================================================================
while array.size(orderBlocks) > maxZones
    ob = array.shift(orderBlocks)
    box.delete(ob.b)
    if not na(ob.l)
        label.delete(ob.l)

// ==================================================================================
// PROFESSIONAL STATUS TABLE
// ==================================================================================
var table statusTable = table.new(position.top_right, 2, 6, 
     bgcolor=color.new(color.black, 10), 
     border_color=color.gray, 
     border_width=2)

if barstate.islast
    // Header
    table.cell(statusTable, 0, 0, "INSTITUTIONAL OB", 
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(statusTable, 1, 0, "STATUS", 
         text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 50))
    
    // Active Zones
    table.cell(statusTable, 0, 1, "Fresh Zones", text_color=color.white, bgcolor=color.new(color.black, 70))
    table.cell(statusTable, 1, 1, str.tostring(array.size(orderBlocks)), 
         text_color=color.yellow, text_size=size.normal, bgcolor=color.new(color.black, 70))
    
    // ATR
    table.cell(statusTable, 0, 2, "ATR (14)", text_color=color.white, bgcolor=color.new(color.black, 70))
    table.cell(statusTable, 1, 2, str.tostring(math.round(atr, 5)), 
         text_color=color.aqua, bgcolor=color.new(color.black, 70))
    
    // Multiplier
    table.cell(statusTable, 0, 3, "Multiplier", text_color=color.white, bgcolor=color.new(color.black, 70))
    table.cell(statusTable, 1, 3, str.tostring(impulseMultiplier), 
         text_color=color.aqua, bgcolor=color.new(color.black, 70))
    
    // Min Body Size
    table.cell(statusTable, 0, 4, "Min Body", text_color=color.white, bgcolor=color.new(color.black, 70))
    table.cell(statusTable, 1, 4, str.tostring(math.round(minBodySize, 5)), 
         text_color=color.orange, bgcolor=color.new(color.black, 70))
    
    // FVG Status
    table.cell(statusTable, 0, 5, "FVG Required", text_color=color.white, bgcolor=color.new(color.black, 70))
    table.cell(statusTable, 1, 5, requireFVG ? "YES (4 Rules)" : "NO (3 Rules)", 
         text_color=requireFVG ? color.red : color.lime, 
         text_size=size.small,
         bgcolor=color.new(color.black, 70))

// ==================================================================================
// ALERTS
// ==================================================================================
alertcondition(validDemandBlock, "Demand Order Block", "Fresh DEMAND Order Block Created!")
alertcondition(validSupplyBlock, "Supply Order Block", "Fresh SUPPLY Order Block Created!")

// ==================================================================================
// END OF INDICATOR
// ==================================================================================
