//@version=6
indicator("Simple Working OB", overlay=true, max_boxes_count=30)

// REALISTIC SETTINGS FOR EUR/USD
impulse = input.float(1.3, "Impulse Multiplier", minval=1.0, maxval=3.0)

// Count zones
var int zoneCount = 0

// ATR
atr = ta.atr(14)

// Detect and draw zones
if bar_index >= 10
    // Pattern
    redToGreen = close[1] < open[1] and close > open
    greenToRed = close[1] > open[1] and close < open
    
    // Big enough
    body = math.abs(close - open)
    big = body > (atr * impulse)
    
    // Break structure
    hh = ta.highest(high, 10)
    ll = ta.lowest(low, 10)
    breakUp = close > hh[1]
    breakDown = close < ll[1]
    
    // DEMAND
    if redToGreen and big and breakUp
        zoneCount := zoneCount + 1
        
        box.new(bar_index[1], open[1], bar_index + 20, low[1], 
             bgcolor=color.new(color.green, 85), 
             border_color=color.green, 
             border_width=2)
        
        label.new(bar_index, low[1], str.tostring(zoneCount) + " BUY", 
             style=label.style_label_up, 
             color=color.green, 
             textcolor=color.white)
    
    // SUPPLY
    if greenToRed and big and breakDown
        zoneCount := zoneCount + 1
        
        box.new(bar_index[1], high[1], bar_index + 20, open[1], 
             bgcolor=color.new(color.red, 85), 
             border_color=color.red, 
             border_width=2)
        
        label.new(bar_index, high[1], str.tostring(zoneCount) + " SELL", 
             style=label.style_label_down, 
             color=color.red, 
             textcolor=color.white)

// Show total count
var table info = table.new(position.top_right, 2, 2, border_width=2)

if barstate.islast
    table.cell(info, 0, 0, "TOTAL ZONES:", bgcolor=color.gray, text_color=color.white)
    table.cell(info, 1, 0, str.tostring(zoneCount), bgcolor=color.gray, text_color=color.yellow, text_size=size.huge)
    
    table.cell(info, 0, 1, "ATR:", text_color=color.white)
    table.cell(info, 1, 1, str.tostring(atr, "#.#####"), text_color=color.aqua)
