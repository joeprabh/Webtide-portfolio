//@version=6
indicator("One Fresh D & S Zone", overlay=true, max_boxes_count=10, max_labels_count=10)

// ==================================================================================
// ONE DEMAND AND ONE SUPPLY ZONE - MOST RECENT FRESH ZONES
// ==================================================================================

bodyMult = input.float(1.8, "Body Multiplier", minval=1.5, maxval=2.5, step=0.1,
     tooltip="Strict = 1.8 or 2.0. Shows only quality zones")
useFVG = input.bool(true, "Use FVG Rule")
bosLen = input.int(10, "BOS Lookback")

type Zone
    box b
    label l = na
    int bar
    float t
    float bt

var Zone demandZone = na
var Zone supplyZone = na

atr = ta.atr(14)

if bar_index >= 12
    // RULE 1: Base
    demandBase = close[1] < open[1] and close > open
    supplyBase = close[1] > open[1] and close < open
    
    // RULE 2: Big Body
    body = math.abs(close - open)
    big = body > atr * bodyMult
    
    // RULE 3: FVG
    dFVG = high[2] < low
    sFVG = low[2] > high
    fvgOK_D = not useFVG or dFVG
    fvgOK_S = not useFVG or sFVG
    
    // RULE 4: BOS
    hh = ta.highest(high, bosLen)
    ll = ta.lowest(low, bosLen)
    bosUp = close > hh[1]
    bosDown = close < ll[1]
    
    // VALID
    validD = demandBase and big and fvgOK_D and bosUp
    validS = supplyBase and big and fvgOK_S and bosDown
    
    // CREATE DEMAND - DELETE OLD ONE
    if validD
        if not na(demandZone)
            box.delete(demandZone.b)
            if not na(demandZone.l)
                label.delete(demandZone.l)
        
        zt = open[1]
        zb = low[1]
        
        b = box.new(bar_index[1], zt, bar_index + 100, zb,
             bgcolor=color.new(color.green, 85),
             border_color=color.green,
             border_width=2)
        
        l = label.new(bar_index[1] + 50, zb, "DEMAND",
             style=label.style_label_up,
             color=color.new(color.green, 20),
             textcolor=color.white,
             size=size.small)
        
        demandZone := Zone.new(b, l, bar_index[1], zt, zb)
    
    // CREATE SUPPLY - DELETE OLD ONE
    if validS
        if not na(supplyZone)
            box.delete(supplyZone.b)
            if not na(supplyZone.l)
                label.delete(supplyZone.l)
        
        zt = high[1]
        zb = open[1]
        
        b = box.new(bar_index[1], zt, bar_index + 100, zb,
             bgcolor=color.new(color.red, 85),
             border_color=color.red,
             border_width=2)
        
        l = label.new(bar_index[1] + 50, zt, "SUPPLY",
             style=label.style_label_down,
             color=color.new(color.red, 20),
             textcolor=color.white,
             size=size.small)
        
        supplyZone := Zone.new(b, l, bar_index[1], zt, zb)

// DELETE DEMAND IF TOUCHED
if not na(demandZone) and bar_index > demandZone.bar
    if low <= demandZone.t and high >= demandZone.bt
        box.delete(demandZone.b)
        if not na(demandZone.l)
            label.delete(demandZone.l)
        demandZone := na

// DELETE SUPPLY IF TOUCHED
if not na(supplyZone) and bar_index > supplyZone.bar
    if low <= supplyZone.t and high >= supplyZone.bt
        box.delete(supplyZone.b)
        if not na(supplyZone.l)
            label.delete(supplyZone.l)
        supplyZone := na

// TABLE
var table t = table.new(position.top_right, 2, 4)
if barstate.islast
    table.cell(t, 0, 0, "Demand Zone", bgcolor=color.new(color.green, 50), text_color=color.white)
    table.cell(t, 1, 0, na(demandZone) ? "NONE" : "ACTIVE", 
         bgcolor=color.new(color.green, 50), 
         text_color=na(demandZone) ? color.red : color.lime)
    
    table.cell(t, 0, 1, "Supply Zone", bgcolor=color.new(color.red, 50), text_color=color.white)
    table.cell(t, 1, 1, na(supplyZone) ? "NONE" : "ACTIVE", 
         bgcolor=color.new(color.red, 50), 
         text_color=na(supplyZone) ? color.red : color.lime)
    
    table.cell(t, 0, 2, "ATR", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(t, 1, 2, str.tostring(math.round(atr, 5)), 
         bgcolor=color.new(color.black, 70), text_color=color.aqua)
    
    table.cell(t, 0, 3, "Min Body", bgcolor=color.new(color.black, 70), text_color=color.white)
    table.cell(t, 1, 3, str.tostring(math.round(atr * bodyMult, 5)), 
         bgcolor=color.new(color.black, 70), text_color=color.orange)
