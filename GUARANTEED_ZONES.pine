//@version=6
indicator("GUARANTEED ZONES - Working", overlay=true, max_boxes_count=100, max_labels_count=100)

// ==================================================================================
// GUARANTEED TO SHOW ZONES - ALL 4 RULES
// ==================================================================================

// RELAXED DEFAULTS - WILL SHOW ZONES
bodyMult = input.float(1.2, "Body Multiplier", minval=0.8, maxval=3.0, step=0.1,
     group="Rules", tooltip="1.2 = Will show zones | 2.0 = Very strict")
useFVG = input.bool(false, "Use FVG Rule (Rule 3)", 
     group="Rules", tooltip="Turn OFF to see more zones")
useBOS = input.bool(true, "Use BOS Rule (Rule 4)", group="Rules")
bosLen = input.int(10, "BOS Lookback", group="Rules")

deleteOnTouch = input.bool(false, "Delete Touched Zones", 
     group="Management", tooltip="Keep OFF to see all zones")
maxShow = input.int(50, "Max Zones", group="Management")

// ==================================================================================
type Zone
    box b
    label l
    int bar
    float t
    float bt

var array<Zone> zones = array.new<Zone>()

atr = ta.atr(14)

// COUNTER FOR DEBUGGING
var int totalCreated = 0

if bar_index >= 12
    // ==================================================================================
    // RULE 1: BASE PATTERN
    // ==================================================================================
    isDemandBase = close[1] < open[1] and close > open
    isSupplyBase = close[1] > open[1] and close < open
    
    // ==================================================================================
    // RULE 2: BIG IMPULSE
    // ==================================================================================
    currBody = math.abs(close - open)
    isBig = currBody > atr * bodyMult
    
    // ==================================================================================
    // RULE 3: FVG (OPTIONAL)
    // ==================================================================================
    hasDemandFVG = high[2] < low
    hasSupplyFVG = low[2] > high
    
    fvgPass_D = not useFVG or hasDemandFVG
    fvgPass_S = not useFVG or hasSupplyFVG
    
    // ==================================================================================
    // RULE 4: BOS (OPTIONAL)
    // ==================================================================================
    highest = ta.highest(high, bosLen)
    lowest = ta.lowest(low, bosLen)
    
    breakHigh = close > highest[1]
    breakLow = close < lowest[1]
    
    bosPass_D = not useBOS or breakHigh
    bosPass_S = not useBOS or breakLow
    
    // ==================================================================================
    // VALID ZONES
    // ==================================================================================
    validDemand = isDemandBase and isBig and fvgPass_D and bosPass_D
    validSupply = isSupplyBase and isBig and fvgPass_S and bosPass_S
    
    // ==================================================================================
    // CREATE DEMAND ZONE
    // ==================================================================================
    if validDemand
        totalCreated += 1
        
        zt = open[1]  // Body top of red candle
        zb = low[1]   // Wick low of red candle
        
        b = box.new(bar_index[1], zt, bar_index + 50, zb,
             bgcolor=color.new(color.green, 85),
             border_color=color.green,
             border_width=2)
        
        l = label.new(bar_index[1] + 25, zb, 
             "D" + str.tostring(totalCreated),
             style=label.style_label_up,
             color=color.new(color.green, 30),
             textcolor=color.white,
             size=size.tiny)
        
        array.push(zones, Zone.new(b, l, bar_index[1], zt, zb))
    
    // ==================================================================================
    // CREATE SUPPLY ZONE
    // ==================================================================================
    if validSupply
        totalCreated += 1
        
        zt = high[1]  // Wick high of green candle
        zb = open[1]  // Body low of green candle
        
        b = box.new(bar_index[1], zt, bar_index + 50, zb,
             bgcolor=color.new(color.red, 85),
             border_color=color.red,
             border_width=2)
        
        l = label.new(bar_index[1] + 25, zt, 
             "S" + str.tostring(totalCreated),
             style=label.style_label_down,
             color=color.new(color.red, 30),
             textcolor=color.white,
             size=size.tiny)
        
        array.push(zones, Zone.new(b, l, bar_index[1], zt, zb))

// ==================================================================================
// DELETE TOUCHED (ONLY IF ENABLED)
// ==================================================================================
if deleteOnTouch and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if bar_index > z.bar
            if low <= z.t and high >= z.bt
                box.delete(z.b)
                label.delete(z.l)
                array.remove(zones, i)

// ==================================================================================
// LIMIT ZONES
// ==================================================================================
while array.size(zones) > maxShow
    z = array.shift(zones)
    box.delete(z.b)
    label.delete(z.l)

// ==================================================================================
// BIG STATUS TABLE
// ==================================================================================
var table tbl = table.new(position.top_right, 2, 7, 
     bgcolor=color.new(color.black, 20),
     border_color=color.white,
     border_width=2)

if barstate.islast
    table.cell(tbl, 0, 0, "STATUS", 
         bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, "VALUE", 
         bgcolor=color.new(color.blue, 40), text_color=color.white, text_size=size.normal)
    
    table.cell(tbl, 0, 1, "Zones Showing", text_color=color.white)
    table.cell(tbl, 1, 1, str.tostring(array.size(zones)), 
         text_color=color.yellow, text_size=size.large)
    
    table.cell(tbl, 0, 2, "Total Created", text_color=color.white)
    table.cell(tbl, 1, 2, str.tostring(totalCreated), text_color=color.lime)
    
    table.cell(tbl, 0, 3, "ATR(14)", text_color=color.white)
    table.cell(tbl, 1, 3, str.tostring(math.round(atr, 5)), text_color=color.aqua)
    
    table.cell(tbl, 0, 4, "Min Body", text_color=color.white)
    table.cell(tbl, 1, 4, str.tostring(math.round(atr * bodyMult, 5)), text_color=color.orange)
    
    table.cell(tbl, 0, 5, "FVG Rule", text_color=color.white)
    table.cell(tbl, 1, 5, useFVG ? "ON" : "OFF", 
         text_color=useFVG ? color.red : color.lime)
    
    table.cell(tbl, 0, 6, "BOS Rule", text_color=color.white)
    table.cell(tbl, 1, 6, useBOS ? "ON" : "OFF", 
         text_color=useBOS ? color.red : color.lime)

// ==================================================================================
plotchar(validDemand, "Demand Signal", "▲", location.belowbar, color.green, size=size.tiny)
plotchar(validSupply, "Supply Signal", "▼", location.abovebar, color.red, size=size.tiny)
