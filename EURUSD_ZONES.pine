//@version=6
indicator("EUR/USD Order Blocks", overlay=true, max_boxes_count=100)

// EVERY Red candle followed by Green candle = DEMAND
// EVERY Green candle followed by Red candle = SUPPLY

// Check previous candle and current candle
if bar_index >= 1
    // Previous candle colors
    prevWasRed = close[1] < open[1]
    prevWasGreen = close[1] > open[1]
    
    // Current candle colors
    currentIsGreen = close > open
    currentIsRed = close < open
    
    // DEMAND ZONE: Red [1] → Green [0]
    if prevWasRed and currentIsGreen
        // Draw box on the RED base candle
        box.new(time[1], open[1], time, low[1], 
             bgcolor=color.new(color.green, 85), 
             border_color=color.green, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        label.new(time, low[1], "BUY", 
             style=label.style_label_up, 
             color=color.green, 
             textcolor=color.white, 
             size=size.normal,
             xloc=xloc.bar_time)
    
    // SUPPLY ZONE: Green [1] → Red [0]
    if prevWasGreen and currentIsRed
        // Draw box on the GREEN base candle
        box.new(time[1], high[1], time, open[1], 
             bgcolor=color.new(color.red, 85), 
             border_color=color.red, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        label.new(time, high[1], "SELL", 
             style=label.style_label_down, 
             color=color.red, 
             textcolor=color.white, 
             size=size.normal,
             xloc=xloc.bar_time)
