//@version=6
indicator("DIAGNOSTIC - See Why No Zones", overlay=true, max_boxes_count=50)

// RELAXED SETTINGS TO START
multiplier = input.float(1.2, "Body Multiplier", minval=0.8, maxval=3.0)
checkFVG = input.bool(false, "Check FVG (Rule 3)")
checkBOS = input.bool(false, "Check BOS (Rule 4)")

var int patterns = 0
var int bigBody = 0
var int passedFVG = 0
var int passedBOS = 0
var int finalZones = 0

var box[] boxes = array.new<box>()

atr = ta.atr(14)

if bar_index >= 10
    // RULE 1: Pattern
    demand = close[1] < open[1] and close > open
    supply = close[1] > open[1] and close < open
    
    if demand or supply
        patterns += 1
        
        // RULE 2: Big Body
        body = math.abs(close - open)
        isBig = body > atr * multiplier
        
        if isBig
            bigBody += 1
            
            // RULE 3: FVG
            demandFVG = high[2] < low
            supplyFVG = low[2] > high
            fvgOK = not checkFVG or (demand and demandFVG) or (supply and supplyFVG)
            
            if fvgOK
                passedFVG += 1
                
                // RULE 4: BOS
                hh = ta.highest(high, 10)
                ll = ta.lowest(low, 10)
                breakUp = close > hh[1]
                breakDown = close < ll[1]
                bosOK = not checkBOS or (demand and breakUp) or (supply and breakDown)
                
                if bosOK
                    passedBOS += 1
                    finalZones += 1
                    
                    // DRAW
                    if demand
                        b = box.new(bar_index[1], open[1], bar_index + 20, low[1],
                             bgcolor=color.new(color.green, 85),
                             border_color=color.green,
                             border_width=2)
                        array.push(boxes, b)
                    else
                        b = box.new(bar_index[1], high[1], bar_index + 20, open[1],
                             bgcolor=color.new(color.red, 85),
                             border_color=color.red,
                             border_width=2)
                        array.push(boxes, b)

// Limit
while array.size(boxes) > 30
    box.delete(array.shift(boxes))

// BIG DIAGNOSTIC TABLE
var table t = table.new(position.top_right, 2, 7, bgcolor=color.black, border_width=2)
if barstate.islast
    table.cell(t, 0, 0, "DIAGNOSTIC", text_color=color.yellow, text_size=size.large)
    table.cell(t, 1, 0, "", bgcolor=color.black)
    
    table.cell(t, 0, 1, "1. Patterns Found", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(patterns), text_color=color.aqua, text_size=size.normal)
    
    table.cell(t, 0, 2, "2. Big Body Pass", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(bigBody), text_color=color.aqua, text_size=size.normal)
    
    table.cell(t, 0, 3, "3. FVG Pass", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(passedFVG), text_color=color.aqua, text_size=size.normal)
    
    table.cell(t, 0, 4, "4. BOS Pass", text_color=color.white)
    table.cell(t, 1, 4, str.tostring(passedBOS), text_color=color.aqua, text_size=size.normal)
    
    table.cell(t, 0, 5, "FINAL ZONES", text_color=color.yellow, text_size=size.large)
    table.cell(t, 1, 5, str.tostring(finalZones), text_color=color.lime, text_size=size.large)
    
    table.cell(t, 0, 6, "ATR × " + str.tostring(multiplier), text_color=color.white)
    table.cell(t, 1, 6, str.tostring(math.round(atr * multiplier, 5)), text_color=color.orange)
