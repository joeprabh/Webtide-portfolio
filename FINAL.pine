//@version=6
indicator("Order Blocks Final", overlay=true, max_boxes_count=50, max_labels_count=50)

// Settings - START WITH THESE
impulse = input.float(1.5, "Body > ATR ×", minval=1.0, maxval=3.0, step=0.1)
useFVG = input.bool(false, "Use FVG Rule", tooltip="OFF = 3 rules, ON = 4 rules")
useBOS = input.bool(true, "Use BOS Rule")
deleteTouch = input.bool(true, "Delete Touched")
maxZ = input.int(30, "Max Zones")

type Z
    box b
    label l
    int bar
    float t
    float bot

var array<Z> zs = array.new<Z>()
atr = ta.atr(14)

if bar_index >= 12
    // Pattern
    dr = close[1] < open[1] and close > open
    sg = close[1] > open[1] and close < open
    
    // Body
    bd = math.abs(close - open)
    big = bd > atr * impulse
    
    // FVG
    dfvg = high[2] < low
    sfvg = low[2] > high
    fok = not useFVG or (dr and dfvg) or (sg and sfvg)
    
    // BOS
    hh = ta.highest(high, 10)
    ll = ta.lowest(low, 10)
    bup = close > hh[1]
    bdn = close < ll[1]
    bok = not useBOS or (dr and bup) or (sg and bdn)
    
    // Valid
    vd = dr and big and fok and bok
    vs = sg and big and fok and bok
    
    // Demand
    if vd
        t = open[1]
        bot = low[1]
        b = box.new(bar_index[1], t, bar_index + 30, bot,
             bgcolor=color.new(color.green, 85),
             border_color=color.green,
             border_width=2)
        l = label.new(bar_index[1], bot, "D",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.tiny)
        array.push(zs, Z.new(b, l, bar_index[1], t, bot))
    
    // Supply
    if vs
        t = high[1]
        bot = open[1]
        b = box.new(bar_index[1], t, bar_index + 30, bot,
             bgcolor=color.new(color.red, 85),
             border_color=color.red,
             border_width=2)
        l = label.new(bar_index[1], t, "S",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.tiny)
        array.push(zs, Z.new(b, l, bar_index[1], t, bot))

// Delete touched
if deleteTouch and array.size(zs) > 0
    for i = array.size(zs) - 1 to 0
        z = array.get(zs, i)
        if bar_index > z.bar and low <= z.t and high >= z.bot
            box.delete(z.b)
            label.delete(z.l)
            array.remove(zs, i)

// Limit
while array.size(zs) > maxZ
    z = array.shift(zs)
    box.delete(z.b)
    label.delete(z.l)

// Table
var table tb = table.new(position.top_right, 2, 4)
if barstate.islast
    table.cell(tb, 0, 0, "Zones", bgcolor=color.black, text_color=color.white)
    table.cell(tb, 1, 0, str.tostring(array.size(zs)), bgcolor=color.black, text_color=color.yellow)
    table.cell(tb, 0, 1, "ATR", bgcolor=color.black, text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(math.round(atr, 5)), bgcolor=color.black, text_color=color.aqua)
    table.cell(tb, 0, 2, "Min Body", bgcolor=color.black, text_color=color.white)
    table.cell(tb, 1, 2, str.tostring(math.round(atr * impulse, 5)), bgcolor=color.black, text_color=color.orange)
    table.cell(tb, 0, 3, "Rules", bgcolor=color.black, text_color=color.white)
    rules = "Base+Body"
    rules := useFVG ? rules + "+FVG" : rules
    rules := useBOS ? rules + "+BOS" : rules
    table.cell(tb, 1, 3, rules, bgcolor=color.black, text_color=color.lime, text_size=size.tiny)
