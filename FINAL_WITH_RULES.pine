//@version=6
indicator("Order Blocks - With Rules", overlay=true, max_boxes_count=50, max_labels_count=50)

// ==================================================================================
// INPUTS - TOGGLE EACH RULE
// ==================================================================================
useImpulseRule = input.bool(false, "RULE 2: Big Impulse Candle (Body > Avg)", group="RULES")
impulseMultiplier = input.float(1.5, "   Multiplier", minval=1.0, maxval=3.0, group="RULES")

useFVGRule = input.bool(false, "RULE 3: Fair Value Gap (Imbalance)", group="RULES")

useBOSRule = input.bool(false, "RULE 4: Break of Structure", group="RULES")
bosLookback = input.int(10, "   Lookback Bars", minval=5, maxval=20, group="RULES")

deleteOnTouch = input.bool(false, "Delete When Price Touches Zone", group="MANAGEMENT")

// ==================================================================================
// STORAGE (for deletion feature)
// ==================================================================================
type Zone
    box b
    label l
    float top
    float bottom

var array<Zone> zones = array.new<Zone>()

// ==================================================================================
// RULE 1: BASE PATTERN (Always Required)
// ==================================================================================
if bar_index >= 1
    prevRed = close[1] < open[1]
    prevGreen = close[1] > open[1]
    currGreen = close > open
    currRed = close < open
    
    demandPattern = prevRed and currGreen
    supplyPattern = prevGreen and currRed
    
    // ==================================================================================
    // RULE 2: BIG IMPULSE (Optional)
    // ==================================================================================
    avgBody = ta.sma(math.abs(close - open), 20)
    currBody = math.abs(close - open)
    isBigCandle = currBody > (avgBody * impulseMultiplier)
    
    impulsePass = not useImpulseRule or isBigCandle
    
    // ==================================================================================
    // RULE 3: FAIR VALUE GAP (Optional)
    // ==================================================================================
    demandFVG = bar_index >= 2 and high[2] < low
    supplyFVG = bar_index >= 2 and low[2] > high
    
    fvgPass_demand = not useFVGRule or demandFVG
    fvgPass_supply = not useFVGRule or supplyFVG
    
    // ==================================================================================
    // RULE 4: BREAK OF STRUCTURE (Optional)
    // ==================================================================================
    highestHigh = ta.highest(high, bosLookback)
    lowestLow = ta.lowest(low, bosLookback)
    
    breakUp = close > highestHigh[1]
    breakDown = close < lowestLow[1]
    
    bosPass_demand = not useBOSRule or breakUp
    bosPass_supply = not useBOSRule or breakDown
    
    // ==================================================================================
    // CHECK ALL RULES
    // ==================================================================================
    validDemand = demandPattern and impulsePass and fvgPass_demand and bosPass_demand
    validSupply = supplyPattern and impulsePass and fvgPass_supply and bosPass_supply
    
    // ==================================================================================
    // DRAW DEMAND ZONE
    // ==================================================================================
    if validDemand
        b = box.new(time[1], open[1], time, low[1], 
             bgcolor=color.new(color.green, 85), 
             border_color=color.green, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        l = label.new(time, low[1], "DEMAND", 
             style=label.style_label_up, 
             color=color.new(color.green, 20), 
             textcolor=color.white, 
             size=size.normal,
             xloc=xloc.bar_time)
        
        array.push(zones, Zone.new(b, l, open[1], low[1]))
    
    // ==================================================================================
    // DRAW SUPPLY ZONE
    // ==================================================================================
    if validSupply
        b = box.new(time[1], high[1], time, open[1], 
             bgcolor=color.new(color.red, 85), 
             border_color=color.red, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        l = label.new(time, high[1], "SUPPLY", 
             style=label.style_label_down, 
             color=color.new(color.red, 20), 
             textcolor=color.white, 
             size=size.normal,
             xloc=xloc.bar_time)
        
        array.push(zones, Zone.new(b, l, high[1], open[1]))

// ==================================================================================
// DELETE TOUCHED ZONES
// ==================================================================================
if deleteOnTouch and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if low <= z.top and high >= z.bottom
            box.delete(z.b)
            label.delete(z.l)
            array.remove(zones, i)

// ==================================================================================
// UPDATE LABELS TO RIGHT EDGE
// ==================================================================================
if barstate.islast and array.size(zones) > 0
    for z in zones
        label.set_x(z.l, time)

// LIMIT ZONES
while array.size(zones) > 50
    z = array.shift(zones)
    box.delete(z.b)
    label.delete(z.l)
