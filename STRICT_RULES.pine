//@version=6
indicator("Institutional Zones - ALL 4 RULES", overlay=true, max_boxes_count=50)

// ==================================================================================
// YOUR EXACT RULES - ALL 4 REQUIRED
// ==================================================================================
// RULE 1: Base Pattern (Red→Green or Green→Red) - ALWAYS CHECKED
// RULE 2: Impulse Body > 2.0 × ATR - ALWAYS CHECKED
// RULE 3: Fair Value Gap - ALWAYS CHECKED  
// RULE 4: Break of Structure - ALWAYS CHECKED
// ==================================================================================

impulseMultiplier = input.float(2.0, "RULE 2: Impulse (Body > ATR × )", minval=1.5, maxval=3.0)
bosLookback = input.int(10, "RULE 4: Structure Lookback", minval=5, maxval=20)
deleteOnTouch = input.bool(true, "Delete When Touched")
maxZoneAge = input.int(30, "Max Zone Age (Days)")

// ==================================================================================
// STORAGE
// ==================================================================================
type Zone
    box b
    label l
    int barIdx
    float top
    float bottom

var array<Zone> zones = array.new<Zone>()

// ==================================================================================
// ATR (Not average body - ATR!)
// ==================================================================================
atr = ta.atr(14)

// ==================================================================================
// ZONE DETECTION
// ==================================================================================
if bar_index >= 2
    // ==================================================================================
    // RULE 1: BASE PATTERN
    // ==================================================================================
    prevRed = close[1] < open[1]
    prevGreen = close[1] > open[1]
    currGreen = close > open
    currRed = close < open
    
    demandBase = prevRed and currGreen
    supplyBase = prevGreen and currRed
    
    // ==================================================================================
    // RULE 2: THE IMPULSE - Body > 2.0 × ATR
    // ==================================================================================
    currBody = math.abs(close - open)
    bigImpulse = currBody > (atr * impulseMultiplier)
    
    // ==================================================================================
    // RULE 3: FAIR VALUE GAP (Imbalance)
    // ==================================================================================
    // For DEMAND: high[2] < low[0] (gap exists)
    demandFVG = high[2] < low
    
    // For SUPPLY: low[2] > high[0] (gap exists)
    supplyFVG = low[2] > high
    
    // ==================================================================================
    // RULE 4: BREAK OF STRUCTURE
    // ==================================================================================
    highestHigh = ta.highest(high, bosLookback)
    lowestLow = ta.lowest(low, bosLookback)
    
    breakHigh = close > highestHigh[1]
    breakLow = close < lowestLow[1]
    
    // ==================================================================================
    // ALL 4 RULES MUST PASS
    // ==================================================================================
    validDemand = demandBase and bigImpulse and demandFVG and breakHigh
    validSupply = supplyBase and bigImpulse and supplyFVG and breakLow
    
    // ==================================================================================
    // DRAW DEMAND ZONE (on RED base candle)
    // ==================================================================================
    if validDemand
        float top = open[1]      // Body high of red candle
        float bottom = low[1]    // Wick low
        
        b = box.new(time[1], top, time, bottom, 
             bgcolor=color.new(color.green, 85), 
             border_color=color.green, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        l = label.new(time, bottom, "DEMAND OB", 
             style=label.style_label_up, 
             color=color.new(color.green, 20), 
             textcolor=color.white, 
             xloc=xloc.bar_time)
        
        array.push(zones, Zone.new(b, l, bar_index - 1, top, bottom))
    
    // ==================================================================================
    // DRAW SUPPLY ZONE (on GREEN base candle)
    // ==================================================================================
    if validSupply
        float top = high[1]      // Wick high
        float bottom = open[1]   // Body low of green candle
        
        b = box.new(time[1], top, time, bottom, 
             bgcolor=color.new(color.red, 85), 
             border_color=color.red, 
             border_width=2, 
             extend=extend.right, 
             xloc=xloc.bar_time)
        
        l = label.new(time, top, "SUPPLY OB", 
             style=label.style_label_down, 
             color=color.new(color.red, 20), 
             textcolor=color.white, 
             xloc=xloc.bar_time)
        
        array.push(zones, Zone.new(b, l, bar_index - 1, top, bottom))

// ==================================================================================
// DELETE TOUCHED ZONES
// ==================================================================================
if deleteOnTouch and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if low <= z.top and high >= z.bottom
            box.delete(z.b)
            label.delete(z.l)
            array.remove(zones, i)

// ==================================================================================
// DELETE OLD ZONES (30 days)
// ==================================================================================
int barsPerDay = timeframe.in_seconds() > 0 ? math.round(86400 / timeframe.in_seconds()) : 24
int maxBars = maxZoneAge * barsPerDay

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        z = array.get(zones, i)
        if bar_index - z.barIdx > maxBars
            box.delete(z.b)
            label.delete(z.l)
            array.remove(zones, i)

// ==================================================================================
// UPDATE LABELS
// ==================================================================================
if barstate.islast and array.size(zones) > 0
    for z in zones
        label.set_x(z.l, time)

// LIMIT
while array.size(zones) > 50
    z = array.shift(zones)
    box.delete(z.b)
    label.delete(z.l)
