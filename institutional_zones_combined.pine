//@version=6
indicator("Institutional Zones - Complete System", overlay=true, max_boxes_count=500, max_labels_count=500)

// ==================================================================================
// INPUTS & SETTINGS
// ==================================================================================

// === ZONE TYPE SELECTION ===
showSupplyDemand = input.bool(true, "Show Supply & Demand Zones", group="Zone Types")
showOrderBlocks = input.bool(true, "Show Order Block Zones", group="Zone Types")

// === SUPPLY & DEMAND SETTINGS ===
sdImpulseMultiplier = input.float(1.5, "S&D Impulse Multiplier", minval=1.0, maxval=5.0, group="Supply & Demand", 
     tooltip="How much larger the impulse must be vs ATR for Supply/Demand zones")
sdSwingLookback = input.int(10, "S&D Swing Lookback", minval=5, maxval=50, group="Supply & Demand")
sdMaxBaseCandles = input.int(3, "S&D Max Base Candles", minval=1, maxval=5, group="Supply & Demand")
sdLiquiditySweepLookback = input.int(5, "S&D Liquidity Sweep Lookback", minval=3, maxval=20, group="Supply & Demand")

// === ORDER BLOCK SETTINGS ===
obImpulseMultiplier = input.float(2.0, "OB Impulse Multiplier", minval=1.0, maxval=5.0, group="Order Blocks",
     tooltip="How much larger the impulse must be vs ATR for Order Blocks (stricter)")
obBOSLookback = input.int(10, "OB Break of Structure Lookback", minval=5, maxval=50, group="Order Blocks")
obAtrPeriod = input.int(14, "OB ATR Period", minval=5, maxval=100, group="Order Blocks")

// === GENERAL SETTINGS ===
avgRangePeriod = input.int(20, "Average Range Period", minval=10, maxval=100, group="General")
wickReductionPercent = input.float(0.5, "Wick Reduction %", minval=0.0, maxval=1.0, step=0.1, group="General")
maxZoneAgeDays = input.int(30, "Max Zone Age (Days)", minval=1, maxval=365, group="General")
maxZonesToShow = input.int(15, "Max Zones Per Type", minval=5, maxval=50, group="General")
showTouchedZones = input.bool(false, "Show Touched Zones", group="General")

// === VISUAL SETTINGS ===
sdDemandColor = input.color(color.new(color.green, 80), "S&D Demand Color", group="Visual - Supply & Demand")
sdSupplyColor = input.color(color.new(color.red, 80), "S&D Supply Color", group="Visual - Supply & Demand")
obDemandColor = input.color(color.new(color.lime, 70), "OB Demand Color", group="Visual - Order Blocks")
obSupplyColor = input.color(color.new(color.orange, 70), "OB Supply Color", group="Visual - Order Blocks")
showLabels = input.bool(true, "Show Zone Labels", group="Visual - General")

// ==================================================================================
// TYPE DEFINITIONS
// ==================================================================================

type Zone
    float top
    float bottom
    int startBar
    int startTime
    bool isSupply
    bool isFresh
    int touchCount
    bool hasLiquiditySweep
    bool hasFVG
    string zoneType  // "SD_Dem", "SD_Sup", "OB_Dem", "OB_Sup"
    string timeframeLabel

// ==================================================================================
// GLOBAL VARIABLES
// ==================================================================================

var array<Zone> allZones = array.new<Zone>()
var array<box> zoneBoxes = array.new<box>()
var array<label> zoneLabels = array.new<label>()

// ==================================================================================
// TIMEFRAME DETECTION
// ==================================================================================

getTimeframeLabel() =>
    string tf = timeframe.period
    string label = ""
    if tf == "240"
        label := "H4"
    else if tf == "60"
        label := "H1"
    else if tf == "15"
        label := "M15"
    else if tf == "5"
        label := "M5"
    else if tf == "D" or tf == "1D"
        label := "D1"
    else if tf == "W" or tf == "1W"
        label := "W1"
    else
        label := tf
    label

currentTF = getTimeframeLabel()

// ==================================================================================
// CALCULATIONS
// ==================================================================================

// Average True Range
atrValue = ta.atr(obAtrPeriod)

// Average Range for S&D
calcAvgRange() =>
    float sum = 0.0
    int validBars = math.min(avgRangePeriod, bar_index)
    if validBars > 0
        for i = 1 to validBars
            sum += high[i] - low[i]
        sum / validBars
    else
        high - low

avgRange = calcAvgRange()

// Current candle properties
isBullish = close > open
isBearish = close < open
bodySize = math.abs(close - open)
candleRange = high - low

// Previous candle properties
isBullish1 = bar_index >= 1 ? close[1] > open[1] : false
isBearish1 = bar_index >= 1 ? close[1] < open[1] : false

// ==================================================================================
// SWING HIGH/LOW DETECTION (For S&D)
// ==================================================================================

isSwingHigh(lookback) =>
    if bar_index < (lookback * 2 + 1)
        false
    else
        bool isHigh = true
        float pivotHigh = high[lookback]
        for i = 0 to lookback - 1
            if high[i] >= pivotHigh
                isHigh := false
                break
        if isHigh
            for i = lookback + 1 to lookback * 2
                if high[i] >= pivotHigh
                    isHigh := false
                    break
        isHigh

isSwingLow(lookback) =>
    if bar_index < (lookback * 2 + 1)
        false
    else
        bool isLow = true
        float pivotLow = low[lookback]
        for i = 0 to lookback - 1
            if low[i] <= pivotLow
                isLow := false
                break
        if isLow
            for i = lookback + 1 to lookback * 2
                if low[i] <= pivotLow
                    isLow := false
                    break
        isLow

getRecentSwingHigh(lookback) =>
    float swingHigh = na
    int maxLookback = math.min(lookback * 3, bar_index - lookback * 2 - 1)
    if maxLookback >= lookback
        for i = lookback to maxLookback
            if isSwingHigh(i)
                swingHigh := high[i]
                break
    swingHigh

getRecentSwingLow(lookback) =>
    float swingLow = na
    int maxLookback = math.min(lookback * 3, bar_index - lookback * 2 - 1)
    if maxLookback >= lookback
        for i = lookback to maxLookback
            if isSwingLow(i)
                swingLow := low[i]
                break
    swingLow

// ==================================================================================
// HIGHEST/LOWEST FUNCTIONS (For OB)
// ==================================================================================

getHighestHigh(lookback) =>
    float highest = high
    if bar_index >= lookback
        highest := high[1]
        for i = 1 to lookback
            if high[i] > highest
                highest := high[i]
    highest

getLowestLow(lookback) =>
    float lowest = low
    if bar_index >= lookback
        lowest := low[1]
        for i = 1 to lookback
            if low[i] < lowest
                lowest := low[i]
    lowest

// ==================================================================================
// SUPPLY & DEMAND ZONE DETECTION
// ==================================================================================

// Rule 1: Explosive Impulse
sdExplosiveBullish = isBullish and candleRange > (avgRange * sdImpulseMultiplier) and bodySize > (candleRange * 0.6)
sdExplosiveBearish = isBearish and candleRange > (avgRange * sdImpulseMultiplier) and bodySize > (candleRange * 0.6)

// Rule 2: Break of Structure
sdRecentSwingHigh = getRecentSwingHigh(sdSwingLookback)
sdRecentSwingLow = getRecentSwingLow(sdSwingLookback)
sdBrokeBullishStructure = not na(sdRecentSwingHigh) and high > sdRecentSwingHigh
sdBrokeBearishStructure = not na(sdRecentSwingLow) and low < sdRecentSwingLow

// Rule 3: Time at Level
countBaseCandles() =>
    int count = 0
    int maxBars = math.min(sdMaxBaseCandles, bar_index)
    for i = 1 to maxBars
        float candleRange = high[i] - low[i]
        if candleRange < (avgRange * 0.8)
            count += 1
        else
            break
    count

sdBaseCandles = countBaseCandles()
sdHasTightBase = sdBaseCandles >= 1 and sdBaseCandles <= sdMaxBaseCandles

// Rule 4: Liquidity Sweep
checkLiquiditySweepBullish() =>
    bool swept = false
    int maxBars = math.min(sdLiquiditySweepLookback, bar_index - 1)
    if maxBars >= 2
        for i = 2 to maxBars
            if low[i] < low[i+1] and low[i] < low[i-1]
                swept := true
                break
    swept

checkLiquiditySweepBearish() =>
    bool swept = false
    int maxBars = math.min(sdLiquiditySweepLookback, bar_index - 1)
    if maxBars >= 2
        for i = 2 to maxBars
            if high[i] > high[i+1] and high[i] > high[i-1]
                swept := true
                break
    swept

sdHasLiqSweepBullish = checkLiquiditySweepBullish()
sdHasLiqSweepBearish = checkLiquiditySweepBearish()

// S&D Zone Calculation
calculateSDDemandZone() =>
    float zoneTop = na
    float zoneBottom = na
    if bar_index >= 1
        if close[1] <= open[1]
            zoneTop := math.max(close[1], open[1])
            zoneBottom := low[1]
            float bodySize = math.abs(close[1] - open[1])
            float wickSize = zoneTop - zoneBottom
            if wickSize > (bodySize * 2) and bodySize > 0
                zoneBottom := zoneBottom + (wickSize * wickReductionPercent)
        else
            zoneTop := high[1]
            zoneBottom := low[1]
    [zoneTop, zoneBottom]

calculateSDSupplyZone() =>
    float zoneTop = na
    float zoneBottom = na
    if bar_index >= 1
        if close[1] >= open[1]
            zoneBottom := math.min(close[1], open[1])
            zoneTop := high[1]
            float bodySize = math.abs(close[1] - open[1])
            float wickSize = zoneTop - zoneBottom
            if wickSize > (bodySize * 2) and bodySize > 0
                zoneTop := zoneTop - (wickSize * wickReductionPercent)
        else
            zoneTop := high[1]
            zoneBottom := low[1]
    [zoneTop, zoneBottom]

// S&D Detection
sdEnoughHistory = bar_index >= (sdSwingLookback * 2 + 1)
sdDemandDetected = showSupplyDemand and sdEnoughHistory and sdExplosiveBullish and sdBrokeBullishStructure and sdHasTightBase
sdSupplyDetected = showSupplyDemand and sdEnoughHistory and sdExplosiveBearish and sdBrokeBearishStructure and sdHasTightBase

// ==================================================================================
// ORDER BLOCK ZONE DETECTION
// ==================================================================================

// Rule 1: Extended Range Candle
obExtendedBullish = isBullish and bodySize > (atrValue * obImpulseMultiplier) and bodySize > (candleRange * 0.6)
obExtendedBearish = isBearish and bodySize > (atrValue * obImpulseMultiplier) and bodySize > (candleRange * 0.6)

// Base Candle Detection
obDemandBase = bar_index >= 1 and isBearish1 and obExtendedBullish
obSupplyBase = bar_index >= 1 and isBullish1 and obExtendedBearish

// Rule 2: Fair Value Gap
checkDemandFVG() =>
    bool hasFVG = false
    if bar_index >= 2
        float gapHigh = high[2]
        float gapLow = low[0]
        if gapLow > gapHigh
            hasFVG := true
    hasFVG

checkSupplyFVG() =>
    bool hasFVG = false
    if bar_index >= 2
        float gapLow = low[2]
        float gapHigh = high[0]
        if gapHigh > gapLow
            hasFVG := true
    hasFVG

obHasDemandFVG = obDemandBase and checkDemandFVG()
obHasSupplyFVG = obSupplyBase and checkSupplyFVG()

// Rule 3: Break of Structure
obDemandBOS = false
if obDemandBase and bar_index >= obBOSLookback
    highestHigh = getHighestHigh(obBOSLookback)
    if close > highestHigh
        obDemandBOS := true

obSupplyBOS = false
if obSupplyBase and bar_index >= obBOSLookback
    lowestLow = getLowestLow(obBOSLookback)
    if close < lowestLow
        obSupplyBOS := true

// OB Zone Calculation
calculateOBDemandZone() =>
    float zoneTop = na
    float zoneBottom = na
    if bar_index >= 1
        zoneTop := math.max(close[1], open[1])
        zoneBottom := low[1]
    [zoneTop, zoneBottom]

calculateOBSupplyZone() =>
    float zoneTop = na
    float zoneBottom = na
    if bar_index >= 1
        zoneTop := high[1]
        zoneBottom := math.min(close[1], open[1])
    [zoneTop, zoneBottom]

// OB Detection
obValidDemand = showOrderBlocks and obDemandBase and obDemandBOS and obHasDemandFVG
obValidSupply = showOrderBlocks and obSupplyBase and obSupplyBOS and obHasSupplyFVG

// ==================================================================================
// ZONE CREATION
// ==================================================================================

// Create S&D Demand Zone
if sdDemandDetected
    [top, bottom] = calculateSDDemandZone()
    if not na(top) and not na(bottom) and top > bottom
        newZone = Zone.new(
             top = top, bottom = bottom, startBar = bar_index - 1, startTime = time[1],
             isSupply = false, isFresh = true, touchCount = 0,
             hasLiquiditySweep = sdHasLiqSweepBullish, hasFVG = false,
             zoneType = "SD_Dem", timeframeLabel = currentTF
         )
        array.unshift(allZones, newZone)

// Create S&D Supply Zone
if sdSupplyDetected
    [top, bottom] = calculateSDSupplyZone()
    if not na(top) and not na(bottom) and top > bottom
        newZone = Zone.new(
             top = top, bottom = bottom, startBar = bar_index - 1, startTime = time[1],
             isSupply = true, isFresh = true, touchCount = 0,
             hasLiquiditySweep = sdHasLiqSweepBearish, hasFVG = false,
             zoneType = "SD_Sup", timeframeLabel = currentTF
         )
        array.unshift(allZones, newZone)

// Create OB Demand Zone
if obValidDemand
    [top, bottom] = calculateOBDemandZone()
    if not na(top) and not na(bottom) and top > bottom
        newZone = Zone.new(
             top = top, bottom = bottom, startBar = bar_index - 1, startTime = time[1],
             isSupply = false, isFresh = true, touchCount = 0,
             hasLiquiditySweep = false, hasFVG = true,
             zoneType = "OB_Dem", timeframeLabel = currentTF
         )
        array.unshift(allZones, newZone)

// Create OB Supply Zone
if obValidSupply
    [top, bottom] = calculateOBSupplyZone()
    if not na(top) and not na(bottom) and top > bottom
        newZone = Zone.new(
             top = top, bottom = bottom, startBar = bar_index - 1, startTime = time[1],
             isSupply = true, isFresh = true, touchCount = 0,
             hasLiquiditySweep = false, hasFVG = true,
             zoneType = "OB_Sup", timeframeLabel = currentTF
         )
        array.unshift(allZones, newZone)

// ==================================================================================
// ZONE MITIGATION & CLEANUP
// ==================================================================================

// Update freshness
if array.size(allZones) > 0
    for i = 0 to array.size(allZones) - 1
        zone = array.get(allZones, i)
        if low <= zone.top and high >= zone.bottom
            zone.touchCount += 1
            if zone.touchCount >= 1
                zone.isFresh := false
        array.set(allZones, i, zone)

// Cleanup zones
int barsPerDay = timeframe.in_seconds() > 0 ? int(86400 / timeframe.in_seconds()) : 24
int maxAgeBars = maxZoneAgeDays * barsPerDay

if array.size(allZones) > 0
    int i = 0
    while i < array.size(allZones)
        zone = array.get(allZones, i)
        int zoneAge = bar_index - zone.startBar
        if (not zone.isFresh and not showTouchedZones) or (zoneAge > maxAgeBars)
            array.remove(allZones, i)
        else
            i += 1

// Limit zones per type
int sdDemandCount = 0
int sdSupplyCount = 0
int obDemandCount = 0
int obSupplyCount = 0

if array.size(allZones) > 0
    int i = 0
    while i < array.size(allZones)
        zone = array.get(allZones, i)
        bool shouldRemove = false
        
        if zone.zoneType == "SD_Dem"
            sdDemandCount += 1
            if sdDemandCount > maxZonesToShow
                shouldRemove := true
        else if zone.zoneType == "SD_Sup"
            sdSupplyCount += 1
            if sdSupplyCount > maxZonesToShow
                shouldRemove := true
        else if zone.zoneType == "OB_Dem"
            obDemandCount += 1
            if obDemandCount > maxZonesToShow
                shouldRemove := true
        else if zone.zoneType == "OB_Sup"
            obSupplyCount += 1
            if obSupplyCount > maxZonesToShow
                shouldRemove := true
        
        if shouldRemove
            array.remove(allZones, i)
        else
            i += 1

// ==================================================================================
// VISUALIZATION
// ==================================================================================

if barstate.islast
    // Clear old drawings
    while array.size(zoneBoxes) > 0
        box.delete(array.shift(zoneBoxes))
    while array.size(zoneLabels) > 0
        label.delete(array.shift(zoneLabels))
    
    // Draw all zones
    if array.size(allZones) > 0
        for i = 0 to array.size(allZones) - 1
            zone = array.get(allZones, i)
            
            if zone.isFresh or showTouchedZones
                // Determine colors and label based on zone type
                color boxColor = na
                color borderColor = na
                string labelText = ""
                string labelStyle = ""
                float labelY = 0.0
                
                if zone.zoneType == "SD_Dem"
                    boxColor := zone.isFresh ? sdDemandColor : color.new(color.green, 95)
                    borderColor := color.new(color.green, zone.isFresh ? 50 : 90)
                    labelText := zone.timeframeLabel + " Dem"
                    if zone.hasLiquiditySweep
                        labelText := labelText + " 🎯"
                    labelStyle := "up"
                    labelY := zone.bottom
                    
                else if zone.zoneType == "SD_Sup"
                    boxColor := zone.isFresh ? sdSupplyColor : color.new(color.red, 95)
                    borderColor := color.new(color.red, zone.isFresh ? 50 : 90)
                    labelText := zone.timeframeLabel + " Sup"
                    if zone.hasLiquiditySweep
                        labelText := labelText + " 🎯"
                    labelStyle := "down"
                    labelY := zone.top
                    
                else if zone.zoneType == "OB_Dem"
                    boxColor := zone.isFresh ? obDemandColor : color.new(color.lime, 95)
                    borderColor := color.new(color.lime, zone.isFresh ? 40 : 90)
                    labelText := zone.timeframeLabel + " OB"
                    labelStyle := "up"
                    labelY := zone.bottom
                    
                else if zone.zoneType == "OB_Sup"
                    boxColor := zone.isFresh ? obSupplyColor : color.new(color.orange, 95)
                    borderColor := color.new(color.orange, zone.isFresh ? 40 : 90)
                    labelText := zone.timeframeLabel + " OB"
                    labelStyle := "down"
                    labelY := zone.top
                
                // Draw box
                zoneBox = box.new(
                     left = zone.startTime, top = zone.top,
                     right = time, bottom = zone.bottom,
                     border_color = borderColor, bgcolor = boxColor,
                     border_width = 1, extend = extend.right,
                     xloc = xloc.bar_time
                 )
                array.push(zoneBoxes, zoneBox)
                
                // Draw label
                if showLabels
                    labelColor = zone.isSupply ? 
                         (zone.zoneType == "OB_Sup" ? color.new(color.orange, 20) : color.new(color.red, 20)) :
                         (zone.zoneType == "OB_Dem" ? color.new(color.lime, 20) : color.new(color.green, 20))
                    
                    zoneLabel = label.new(
                         x = time, y = labelY, text = labelText,
                         style = labelStyle == "up" ? label.style_label_up : label.style_label_down,
                         color = labelColor, textcolor = color.white,
                         size = size.tiny, xloc = xloc.bar_time
                     )
                    array.push(zoneLabels, zoneLabel)

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(sdDemandDetected, title="S&D Demand Zone", message="New Supply & Demand DEMAND zone!")
alertcondition(sdSupplyDetected, title="S&D Supply Zone", message="New Supply & Demand SUPPLY zone!")
alertcondition(obValidDemand, title="OB Demand Zone", message="New Order Block DEMAND zone!")
alertcondition(obValidSupply, title="OB Supply Zone", message="New Order Block SUPPLY zone!")

// ==================================================================================
// DEBUG PLOTS
// ==================================================================================

plotchar(sdDemandDetected, "S&D Demand", "●", location.belowbar, color.green, size=size.tiny)
plotchar(sdSupplyDetected, "S&D Supply", "●", location.abovebar, color.red, size=size.tiny)
plotchar(obValidDemand, "OB Demand", "▲", location.belowbar, color.lime, size=size.small)
plotchar(obValidSupply, "OB Supply", "▼", location.abovebar, color.orange, size=size.small)
