//@version=6
indicator("Actually Works", overlay=true, max_boxes_count=50)

// VERY LOW requirements to see zones
impulse = input.float(0.8, "Impulse (LOW = more zones)", minval=0.5, maxval=2.0, step=0.1)

var int count = 0
atr = ta.atr(14)

if bar_index >= 10
    // Pattern check
    demand = close[1] < open[1] and close > open
    supply = close[1] > open[1] and close < open
    
    // Body check (VERY LOW threshold)
    body = math.abs(close - open)
    bigEnough = body > (atr * impulse)
    
    // Structure check
    hh = ta.highest(high, 10)
    ll = ta.lowest(low, 10)
    up = close > hh[1]
    down = close < ll[1]
    
    // DEMAND ZONE
    if demand and bigEnough and up
        count := count + 1
        box.new(bar_index[1], open[1], bar_index + 15, low[1], 
             bgcolor=color.new(color.green, 80), 
             border_color=color.green, 
             border_width=3)
        label.new(bar_index, low[1], "DEMAND " + str.tostring(count), 
             style=label.style_label_up, 
             color=color.green, 
             textcolor=color.white, 
             size=size.large)
    
    // SUPPLY ZONE
    if supply and bigEnough and down
        count := count + 1
        box.new(bar_index[1], high[1], bar_index + 15, open[1], 
             bgcolor=color.new(color.red, 80), 
             border_color=color.red, 
             border_width=3)
        label.new(bar_index, high[1], "SUPPLY " + str.tostring(count), 
             style=label.style_label_down, 
             color=color.red, 
             textcolor=color.white, 
             size=size.large)

// Show stats
var table t = table.new(position.top_right, 2, 3)

if barstate.islast
    table.cell(t, 0, 0, "ZONES FOUND", bgcolor=color.blue, text_color=color.white, text_size=size.large)
    table.cell(t, 1, 0, str.tostring(count), bgcolor=color.blue, text_color=color.yellow, text_size=size.huge)
    
    table.cell(t, 0, 1, "ATR", text_color=color.white)
    table.cell(t, 1, 1, str.tostring(atr, format.mintick), text_color=color.aqua)
    
    table.cell(t, 0, 2, "Min Body", text_color=color.white)
    table.cell(t, 1, 2, str.tostring(atr * impulse, format.mintick), text_color=color.orange)
